generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  password     String
  role         RoleEnum
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  adminClinic  AdminClinic?
  doctor       Doctor?
  patient      Patient?
  receptionist Receptionist?
  superAdmin   SuperAdmin?
}

model SuperAdmin {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id])
}

model Clinic {
  id                 Int                @id @default(autoincrement())
  name               String             @unique
  address            String?
  phone              String?
  subscriptionEnd    DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  subscriptionStart  DateTime?
  subscriptionType   SubscriptionType   @default(FREE)
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  taxId              String             @unique
  isActive           Boolean            @default(false)
  admins             AdminClinic[]
  appointments       Appointment[]
  doctors            Doctor[]
  invoices           Invoice[]
  patients           Patient[]
  receptionists      Receptionist[]
}

model AdminClinic {
  id        Int      @id @default(autoincrement())
  clinicId  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(false)
  userId    Int      @unique
  clinic    Clinic?  @relation(fields: [clinicId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Specialization {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctors   Doctor[]
}

model Receptionist {
  id           Int           @id @default(autoincrement())
  userId       Int           @unique
  clinicId     Int
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[] @relation("ReceptionistAppointments")
  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  doctors      Doctor[]      @relation("DoctorReceptionist")
}

model Doctor {
  id               Int             @id @default(autoincrement())
  userId           Int             @unique
  clinicId         Int
  specializationId Int?
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  appointments     Appointment[]   @relation("DoctorAppointments")
  clinic           Clinic          @relation(fields: [clinicId], references: [id])
  specialization   Specialization? @relation(fields: [specializationId], references: [id])
  user             User            @relation(fields: [userId], references: [id])
  patients         Patient[]       @relation("DoctorPatients")
  receptionists    Receptionist[]  @relation("DoctorReceptionist")
}

model Patient { 
  id             Int             @id @default(autoincrement())
  clinicId       Int
  userId         Int             @unique
  phoneNumber    String?         // <-- nouveau champ ajouté
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  isActive       Boolean         @default(true)
  appointments   Appointment[]
  invoices       Invoice[]
  medicalRecords MedicalRecord[]
  clinic         Clinic          @relation(fields: [clinicId], references: [id])
  user           User            @relation(fields: [userId], references: [id])
  doctors        Doctor[]        @relation("DoctorPatients")
}

model Appointment {
  id             Int               @id @default(autoincrement())
  patientId      Int
  doctorId       Int
  receptionistId Int
  clinicId       Int
  date           DateTime
  status         AppointmentStatus
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  clinic         Clinic            @relation(fields: [clinicId], references: [id])
  doctor         Doctor            @relation("DoctorAppointments", fields: [doctorId], references: [id])
  patient        Patient           @relation(fields: [patientId], references: [id])
  receptionist   Receptionist      @relation("ReceptionistAppointments", fields: [receptionistId], references: [id])
}

model MedicalRecord {
  id            Int      @id @default(autoincrement())
  patientId     Int
  description   String
  prescriptions Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  patient       Patient  @relation(fields: [patientId], references: [id])
}

model Invoice {
  id            Int           @id @default(autoincrement())
  patientId     Int
  clinicId      Int
  amount        Float
  status        InvoiceStatus
  paymentMethod String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  clinic        Clinic        @relation(fields: [clinicId], references: [id])
  patient       Patient       @relation(fields: [patientId], references: [id])
}

enum RoleEnum {
  SUPERADMIN
  ADMIN_CLINIC
  DOCTOR
  RECEPTIONIST
  PATIENT
}

enum SubscriptionType {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PENDING_PAYMENT
  EXPIRED
  TRIAL
}

enum AppointmentStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
  IN_PROGRESS
}

enum InvoiceStatus {
  PAID
  PENDING
  CANCELLED
}
